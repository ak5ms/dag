+def _lookup_or_insert_slots(
+    table: GroupTableState,
+    key_matrix: jax.Array,
+) -> tuple[jax.Array, GroupTableState]:
+    """Resolve one keyed slot per member while keeping RHS work vectorized."""
+    width = key_matrix.shape[0]
+    slots0 = jnp.empty((width,), dtype=jnp.int32)
+
+    def body(member_pos, carry):
+        table_c, slots_c = carry
+        slot, table_n = _lookup_or_insert_slot(table_c, key_matrix[member_pos])
+        return table_n, slots_c.at[member_pos].set(slot)
+
+    table_next, slots = jax.lax.fori_loop(0, width, body, (table, slots0))
+    return slots, table_next
+
