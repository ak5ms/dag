+def _tree_take_slot_members(tree: Any, slots: jax.Array):
+    """Gather one independent member state from each keyed slot.
+
+    Memberwise formula graphs currently store every state leaf as
+    ``(capacity, group_width, ...)``.  Advanced indexing therefore lifts the
+    complete inner graph state for all members in one operation, so the RHS can
+    be evaluated with a single ``vmap`` instead of a sequential member loop.
+    """
+    tree = _ensure_dataclass_pytree(tree)
+    members = jnp.arange(slots.shape[0], dtype=jnp.int32)
+
+    def take_leaf(leaf):
+        leaf = jnp.asarray(leaf)
+        return leaf[slots, members]
+
+    return jax.tree_util.tree_map(take_leaf, tree)
+
+
+def _tree_set_slot_members(tree: Any, slots: jax.Array, value: Any):
+    """Scatter a batched memberwise inner state back to keyed slots."""
+    tree = _ensure_dataclass_pytree(tree)
+    value = _ensure_dataclass_pytree(value)
+    members = jnp.arange(slots.shape[0], dtype=jnp.int32)
+    return jax.tree_util.tree_map(lambda dst, src: dst.at[slots, members].set(src), tree, value)
+
+
